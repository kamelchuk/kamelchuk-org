---
// Журнал приймальні (CRM для команди). Сторінка віддається лише після входу через Cloudflare Access
// (перевірка в worker/journal/api.ts); дані завантажуються з /api/journal/*. Не індексується.
import '../../styles/global.css';
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Журнал приймальні — Камельчук</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="jr">
  <header class="jbar">
    <a class="jlogo" href="#/"><span>📥</span><strong>Журнал приймальні</strong></a>
    <nav id="nav" class="jnav"></nav>
    <div id="me" class="jme"></div>
  </header>
  <main id="view" class="jwrap"><p class="muted loading">Завантаження…</p></main>
  <script>import '../../journal/app.ts';</script>
</body>
</html>

<style is:global>
  body.jr { background: var(--bg-soft); font-size: 15px; }
  .jbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 20px; padding: 10px 20px; background: var(--ink-2); color: #fff; flex-wrap: wrap; }
  .jlogo { display: flex; gap: 8px; align-items: center; text-decoration: none; font-family: var(--font-head); }
  .jnav { display: flex; gap: 4px; flex: 1; flex-wrap: wrap; align-items: center; }
  .jnav a { padding: 6px 10px; border-radius: 999px; text-decoration: none; color: #dfe3ea; font-weight: 600; font-size: .9rem; }
  .jnav a.active, .jnav a:hover { background: rgba(255,255,255,.12); color: #fff; }
  .jnav a.new { margin-left: auto; padding: 7px 16px; color: #062b28; }
  .jnav a.help { background: #2ee6d6; color: #062b28; }
  .jnav a.help:hover, .jnav a.help.active { background: #5ff0e3; color: #062b28; box-shadow: 0 0 0 2px rgba(255,255,255,.35); }
  /* інструкція */
  .help { max-width: 960px; margin: 0 auto; line-height: 1.6; }
  .help .lead { font-size: 1.05rem; }
  .help section { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px; margin-bottom: 16px; scroll-margin-top: 80px; }
  .help h2 { font-size: 1.25rem; margin-bottom: 12px; }
  .help ol, .help ul { padding-left: 1.3em; }
  .help li { margin: 4px 0; }
  .help figure { margin: 16px 0; }
  .help figure img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 4px 14px rgba(20,30,50,.08); }
  .help figure img[src*="13-status"] { max-width: 420px; }
  .help figcaption { font-size: .85rem; color: #6b7280; margin-top: 6px; }
  .help .tip { background: #dffcf8; border-left: 4px solid #00bfae; padding: 10px 14px; border-radius: 6px; }
  .help .toc ol { columns: 2; margin: 8px 0 0; }
  .help .toc a { text-decoration: none; }
  .help .ht { border-collapse: collapse; margin: 12px 0; width: 100%; }
  .help .ht th, .help .ht td { border: 1px solid var(--line); padding: 7px 10px; text-align: left; vertical-align: top; }
  .help .ht th { background: var(--bg-soft); }
  @media print {
    .jbar, .noprint, .toast { display: none !important; }
    body.jr { background: #fff; font-size: 12px; }
    .jwrap { padding: 0; max-width: none; }
    .help section { border: 0; padding: 0; margin: 0 0 18px; break-inside: auto; }
    .help h2 { break-after: avoid; }
    .help figure { break-inside: avoid; }
    .help figure img { max-height: 235mm; width: auto; max-width: 100%; box-shadow: none; }
    .help .toc { border: 1px solid var(--line); }
  }
  .jme { display: flex; gap: 8px; align-items: baseline; font-size: .85rem; }
  .jme small { color: #aab0bb; }
  .jme a { color: #aab0bb; margin-left: 6px; }
  .jwrap { max-width: 1280px; margin: 0 auto; padding: 24px 20px 64px; }
  .jr h1 { font-size: 1.6rem; margin: 0; }
  .jr h2 { font-size: 1.05rem; margin: 0 0 12px; }
  .head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .grow { flex: 1; }
  .card { padding: 20px; margin-bottom: 16px; }
  .card.err { background: #ffecec; color: #8a1c1c; }
  .card.ok { background: #dffcf8; }
  .btn.sm { padding: .45em 1em; font-size: .85rem; }
  .btn:disabled { opacity: .5; cursor: wait; }
  .lnk { background: none; border: 0; color: var(--blue); font: inherit; font-weight: 600; cursor: pointer; padding: 4px 6px; }
  .lnk.red, .red { color: #b42318; }
  .muted small, small.muted { display: block; }
  .jr .field { margin-bottom: 14px; }
  .jr .field small { margin-top: 4px; font-size: .8rem; }
  .jr .field.miss label { color: #b42318; }
  .jr input, .jr select, .jr textarea { padding: 9px 12px; }

  /* плитки й графіки */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .tile { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; display: flex; flex-direction: column; gap: 2px; }
  a.tile[href]:hover { border-color: var(--accent); }
  .tile b { font-family: var(--font-head); font-size: 2rem; line-height: 1.1; }
  .tile span { color: var(--muted); font-size: .85rem; }
  .tile.red { background: #fff1f0; border-color: #ffc9c4; } .tile.yellow { background: #fffbe6; border-color: #ffe58f; }
  .tile.orange { background: #fff4e6; border-color: #ffd19a; } .tile.blue { background: #eef2ff; border-color: #c7d2fe; }
  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
  .span2 { grid-column: 1 / -1; }
  .bars { display: grid; gap: 6px; }
  .bar { display: grid; grid-template-columns: minmax(110px, 38%) 1fr 36px; gap: 10px; align-items: center; text-decoration: none; font-size: .88rem; }
  a.bar[href]:hover .bl { color: var(--blue); }
  .bt { background: var(--bg-soft); border-radius: 6px; height: 12px; overflow: hidden; }
  .bt i { display: block; height: 100%; background: var(--accent); border-radius: 6px; min-width: 3px; }
  .bar b { text-align: right; }
  .months { display: flex; gap: 10px; align-items: flex-end; height: 160px; }
  .mcol { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; font-size: .78rem; }
  .mbars { flex: 1; width: 100%; display: flex; gap: 3px; align-items: flex-end; justify-content: center; }
  .mbars i, .legend i { display: inline-block; width: 14px; border-radius: 4px 4px 0 0; min-height: 2px; }
  .legend { font-size: .8rem; color: var(--muted); } .legend i { height: 10px; border-radius: 3px; margin-left: 8px; }
  .o { background: var(--accent); } .c { background: var(--blue); }
  .tbl { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .tbl th { text-align: left; color: var(--muted); font-weight: 600; border-bottom: 1px solid var(--line); padding: 6px 8px; }
  .tbl td { border-bottom: 1px solid var(--line); padding: 7px 8px; }
  .att { display: grid; }
  .att-row { display: grid; grid-template-columns: 170px 120px 1fr 120px 130px; gap: 10px; align-items: center; padding: 10px 4px; border-bottom: 1px solid var(--line); text-decoration: none; font-size: .9rem; }
  .att-row:hover { background: var(--bg-soft); }
  .att-id { font-family: var(--font-head); font-weight: 600; }

  /* бейджі */
  .badge { display: inline-block; padding: .15em .65em; border-radius: 999px; font-size: .78rem; font-weight: 700; white-space: nowrap; }
  .st-new { background: #eef2ff; color: #3e5496; } .st-work { background: #dffcf8; color: #00695f; } .st-warn { background: #fff4e6; color: #a15c00; }
  .st-done { background: #e6f7e9; color: #1d7a34; } .st-closed { background: #eceef2; color: #5a5f6b; }
  .as-overdue { background: #fff1f0; color: #b42318; } .as-soon { background: #fffbe6; color: #8a6500; } .as-react { background: #fff4e6; color: #a15c00; }
  .as-answered, .as-full { background: #e6f7e9; color: #1d7a34; } .as-wait { background: #eef2ff; color: #3e5496; } .as-none { background: #eceef2; color: #5a5f6b; }
  .dot { display: inline-grid; place-items: center; min-width: 20px; height: 20px; border-radius: 999px; font-size: .72rem; font-weight: 700; color: #fff; margin-left: 4px; padding: 0 5px; }
  .dot.red { background: #d92d20; } .dot.yellow { background: #e0a800; } .dot.orange { background: #f08c00; }

  /* список справ */
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; align-items: center; }
  .filters input[type=search] { flex: 1 1 260px; width: auto; }
  .filters select { width: auto; flex: 0 1 190px; }
  .filters .check { white-space: nowrap; font-weight: 400; }
  .rows { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .row { display: grid; grid-template-columns: 150px 90px 1.2fr 2fr 110px 140px 150px; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); text-decoration: none; align-items: start; font-size: .9rem; }
  a.row:hover { background: #f8fafc; }
  .row.hdr { font-weight: 600; color: var(--muted); font-size: .8rem; background: var(--bg-soft); }
  .row .id { font-family: var(--font-head); font-weight: 600; }
  .row .sum { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .empty { padding: 24px; margin: 0; }

  /* майстер */
  .steps { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0 0 16px; flex-wrap: wrap; }
  .steps li { display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border-radius: 999px; background: #fff; border: 1px solid var(--line); color: var(--muted); font-size: .85rem; font-weight: 600; }
  .steps li span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--bg-soft); }
  .steps li.on { color: var(--ink); border-color: var(--accent); } .steps li.on span { background: var(--accent); }
  .steps li.done span { background: #c9f3ee; }
  .wiz { max-width: 820px; }
  .wiz-nav { display: flex; gap: 10px; justify-content: flex-end; align-items: center; margin-top: 12px; flex-wrap: wrap; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { margin: 0 !important; font-weight: 400 !important; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chip span { display: inline-block; padding: 7px 14px; border: 1px solid #cfd4dd; border-radius: 999px; background: #fff; font-size: .9rem; }
  .chip input:checked + span { background: var(--accent); border-color: var(--accent); color: #062b28; font-weight: 600; }
  .chip input:focus-visible + span { outline: 2px solid var(--blue); }
  .review { display: grid; grid-template-columns: 180px 1fr; gap: 6px 16px; }
  .review dt, .kv dt { color: var(--muted); font-size: .85rem; } .review dd, .kv dd { margin: 0; white-space: pre-wrap; }

  /* картка справи */
  .case-head h1 { font-size: 1.8rem; }
  .back { text-decoration: none; color: var(--muted); width: 100%; font-size: .85rem; }
  .inline { display: flex; gap: 8px; align-items: center; font-weight: 600; font-size: .85rem; }
  .inline select { width: auto; }
  .case-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); gap: 16px; align-items: start; }
  .sec-h { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .sec-h h2 { margin: 0; }
  .summary { font-size: 1.05rem; font-weight: 600; margin: 0 0 12px; }
  .kv { display: grid; grid-template-columns: 150px 1fr; gap: 6px 16px; margin: 12px 0 0; }
  .pre { white-space: pre-wrap; margin: 6px 0; }
  details summary { cursor: pointer; }
  .g2f { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .acts { display: grid; gap: 10px; }
  .act { border: 1px solid var(--line); border-left: 4px solid #cfd4dd; border-radius: 10px; padding: 12px 14px; }
  .as-b-overdue { border-left-color: #d92d20; } .as-b-soon { border-left-color: #e0a800; } .as-b-react { border-left-color: #f08c00; }
  .as-b-answered, .as-b-full { border-left-color: #2e9e4f; } .as-b-wait { border-left-color: var(--blue); }
  .act-btns { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .act-top { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .act-date { font-family: var(--font-head); font-weight: 600; color: var(--muted); }
  .act-body { display: grid; gap: 2px; margin-top: 6px; font-size: .9rem; }
  .warnline { color: #a15c00; }
  .act-form, #newAct { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); }
  #newAct { border: 1px solid var(--accent); border-radius: 10px; padding: 14px; margin-bottom: 12px; }
  .ans { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin: 8px 0; }
  .ans legend { font-weight: 700; padding: 0 6px; }
  .due { margin: 0 0 6px; }
  .note-form { display: grid; gap: 8px; justify-items: end; margin-bottom: 12px; }
  .note { border-top: 1px solid var(--line); padding: 8px 0; }
  .hist { padding-left: 18px; font-size: .85rem; }
  .hist li { margin: 6px 0; }
  .users { display: grid; gap: 8px; }
  .user { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; }
  .user form { margin-top: 12px; }
  .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 10px; z-index: 50; box-shadow: 0 6px 24px rgba(0,0,0,.2); }
  .toast.bad { background: #b42318; }

  @media (max-width: 960px) {
    .grid2, .case-grid { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .row.hdr { display: none; }
    .row > span:nth-child(2) { text-align: right; }
    .row > span:nth-child(3), .row > span:nth-child(4) { grid-column: 1 / -1; }
    .row > span:nth-child(5)::after { content: ' ·'; }
    .att-row { grid-template-columns: 1fr auto; gap: 4px 10px; }
    .att-row .att-main { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .jwrap { padding: 16px 16px 48px; }
    .jbar { gap: 8px 12px; padding: 10px 16px; }
    .jlogo { flex: 1; }
    .jnav { order: 3; flex: 1 1 100%; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .jnav a { white-space: nowrap; flex: none; }
    .jnav a.new { margin-left: 0; }
    .jme small { display: none; }
    .g2f, .review, .kv { grid-template-columns: 1fr; }
    .kv dd, .review dd { margin-bottom: 6px; }
    .filters select { flex: 1 1 45%; }
    .tile b { font-size: 1.6rem; }
    .bar { grid-template-columns: minmax(90px, 40%) 1fr 30px; }
  }
</style>
