---
import V from '../../views/DocPage.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const docs = await getCollection('docs', (e) => !e.data.hidden);
  return docs.map((entry) => ({ params: { slug: entry.id.split('/')[1] }, props: { entry } }));
}
const { entry } = Astro.props;
---
<V entry={entry} />
