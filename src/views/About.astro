---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import type { Lang } from '../data/site';
import { photos } from '../data/site';
import { t, href } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang); const uk = lang === 'uk';
const roles = uk
  ? [['Народний депутат і дипломат', 'Захищає інтереси України в делегації до Ради Європи (ПАРЄ).'], ['Підприємець', 'Досвід ведення бізнесу з 1997 року. Започаткував понад 15 компаній, зробив успішний вихід із двох.'], ['Меценат', 'Фінансує створення Центру Відновлення Ветеранів і керує Фондом Родини Камельчуків.']]
  : [['MP and diplomat', 'Defends Ukraine\'s interests in the delegation to the Council of Europe (PACE).'], ['Entrepreneur', 'In business since 1997. Founded more than 15 companies and successfully exited two.'], ['Philanthropist', 'Funds the Veterans Recovery Center and runs the Kamelchuk Family Foundation.']];
const facts = uk
  ? ['Автор законів «Про системи зберігання енергії» та «Про розвиток інфраструктури для заряджання електромобілів».', 'Співавтор майже 500 законопроєктів.', 'Голова міжфракційного депутатського об\'єднання «Ініціатива Трьох Морів».', 'Заступник співголови груп дружби з Катаром, Сингапуром і Бельгією.', 'Кандидат на посаду міністра енергетики України у 2025 році.']
  : ['Author of the laws "On Energy Storage Systems" and "On the Development of EV Charging Infrastructure".', 'Co-author of almost 500 bills.', 'Chair of the cross-party parliamentary group "Three Seas Initiative".', 'Deputy co-chair of the friendship groups with Qatar, Singapore and Belgium.', 'Candidate for Minister of Energy of Ukraine in 2025.'];
---
<Base lang={lang} title={s.about} alt={href('about', uk ? 'en' : 'uk')}>
  <PageHead eyebrow={s.about} title={uk ? 'Камельчук Юрій Олександрович' : 'Yurii Oleksandrovych Kamelchuk'} />
  <section class="section"><div class="wrap ab">
    <img src={photos.portrait} alt={s.name} class="ph" />
    <div class="prose">
      {uk ? <>
        <p class="big">Український політик. Народний депутат Верховної Ради України. Член комітету з питань енергетики. Учасник постійної делегації України до Парламентської асамблеї Ради Європи (ПАРЄ). Засновник і лідер партії «Українська Нація».</p>
        <p>Закінчив Львівський національний університет імені Івана Франка за спеціальністю «Журналістика» та магістратуру Київського національного університету імені Тараса Шевченка за спеціальністю «Державне управління». Працює над науковою роботою в аспірантурі факультету міжнародних відносин ЛНУ імені Івана Франка.</p>
        <p>Засновник Української Бізнес Спільноти, Української Бізнес Платформи, Cardinal University, Cardinal Capital, Центру Підтримки Військових, Центру Відновлення Ветеранів, Центру Підтримки Української Нації.</p>
      </> : <>
        <p class="big">Ukrainian politician. Member of the Verkhovna Rada of Ukraine and of its Energy Committee. Member of Ukraine's permanent delegation to the Parliamentary Assembly of the Council of Europe (PACE). Founder and leader of the Ukrainian Nation party.</p>
        <p>Graduated in Journalism from Ivan Franko National University of Lviv and holds a master's degree in Public Administration from Taras Shevchenko National University of Kyiv. Currently a postgraduate researcher at the Faculty of International Relations, Ivan Franko National University of Lviv.</p>
        <p>Founder of the Ukrainian Business Community, the Ukrainian Business Platform, Cardinal University, Cardinal Capital, the Military Support Center, the Veterans Recovery Center and the Ukrainian Nation Support Center.</p>
      </>}
    </div>
  </div></section>
  <section class="section soft"><div class="wrap grid g3">
    {roles.map(([a, b]) => <div class="card"><h3>{a}</h3><p class="muted">{b}</p></div>)}
  </div></section>
  <section class="section"><div class="wrap prose">
    <h2>{uk ? 'Ключові факти' : 'Key facts'}</h2>
    <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
  </div></section>
</Base>
<style>
  .ab { display: grid; grid-template-columns: 380px 1fr; gap: 48px; align-items: start; }
  .ph { border-radius: var(--radius); width: 100%; }
  .big { font-size: 1.2rem; font-weight: 600; }
  .facts li { margin-bottom: 10px; }
  @media (max-width: 820px) { .ab { grid-template-columns: 1fr; } .ph { max-width: 380px; } }
</style>
