---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import type { Lang } from '../data/site';
import { t, href } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang); const uk = lang === 'uk';
---
<Base lang={lang} title={s.party} alt={href('party', uk ? 'en' : 'uk')}>
  <PageHead eyebrow={s.party} title={uk ? 'Партія «Українська Нація»' : 'Ukrainian Nation party'} lead={uk ? 'Юрій Камельчук — засновник і лідер сучасної політичної партії «Українська Нація».' : 'Yurii Kamelchuk is the founder and leader of the modern political party Ukrainian Nation.'} />
  <section class="section"><div class="wrap grid g2">
    <div class="prose"><p>{uk ? 'Тут буде коротко про цінності, програму та новини партії. Вступ до партії, запис волонтером і пропозиції партнерства — на офіційному сайті партії.' : 'A short overview of the party\'s values, programme and news. Membership, volunteering and partnership proposals are handled on the party\'s official website.'}</p>
      <a class="btn btn-primary" href="https://uanation.org" target="_blank" rel="noopener">uanation.org ↗</a></div>
    <div class="placeholder">{s.soon}</div>
  </div></section>
</Base>
