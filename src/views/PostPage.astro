---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import type { Lang } from '../data/site';
import { t, href, fmtDate } from '../i18n';
const { lang, kind, entry, altUrl } = Astro.props as { lang: Lang; kind: 'news' | 'blog'; entry: any; altUrl: string };
const s = t(lang);
const { Content } = await render(entry);
---
<Base lang={lang} title={entry.data.title} description={entry.data.excerpt} alt={altUrl}>
  <article class="section"><div class="wrap prose">
    <a href={href(kind, lang)} class="muted" style="text-decoration:none">← {s[kind]}</a>
    <div style="margin:20px 0 8px">{entry.data.tag && <span class="tag">{entry.data.tag}</span>} <time class="muted">{fmtDate(entry.data.date, lang)}</time></div>
    <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">{entry.data.title}</h1>
    {entry.data.image && <img src={entry.data.image} alt="" style="border-radius:var(--radius);margin:24px 0" />}
    <Content />
  </div></article>
</Base>
