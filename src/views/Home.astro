---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import HqMap from '../components/HqMap.astro';
import JoinCta from '../components/JoinCta.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';
import { photos, pillars, triad, statuses, projects, hqs, orgs } from '../data/site';
import { t, href } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const uk = lang === 'uk';
const news = (await getCollection('news', (e) => e.id.startsWith(lang + '/') && !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const featured = [1, 5, 10, 13, 14, 16, 19, 21].map((i) => projects[i]);
---
<Base lang={lang} alt={uk ? '/en/' : '/'}>
  <section class="hero"><div class="wrap hero-in">
    <div class="hero-text">
      <div class="eyebrow">{uk ? 'Команда Юрія Камельчука · Українська Нація' : 'Yurii Kamelchuk’s team · Ukrainian Nation'}</div>
      <h1>{uk ? 'Збираємо команду для оновлення України' : 'Building a team to renew Ukraine'}</h1>
      <p class="hero-lead">{uk
        ? 'Юрій Камельчук — політик сильної держави, який пояснює складну політику просто, має парламентський і міжнародний досвід та збирає команду для оновлення України.'
        : 'Yurii Kamelchuk is a politician for a strong state who explains complex politics simply, brings parliamentary and international experience, and is building a team to renew Ukraine.'}</p>
      <p class="hero-sub">{uk ? 'Лідер політичної сили з планом держави.' : 'The leader of a political force with a plan for the state.'}</p>
      <div class="hero-btns">
        <a class="btn btn-primary" href={href('join', lang)}>{s.join}</a>
        <a class="btn btn-ghost" href={href('ideas', lang)}>{uk ? 'Наші ідеї' : 'Our ideas'}</a>
      </div>
    </div>
    <img class="portrait" src={photos.portrait} alt={s.leader} />
  </div></section>

  <section class="triad"><div class="wrap grid g3">
    {triad.map((x) => <div class="tri"><strong>{x[lang].t}</strong><span>{x[lang].d}</span></div>)}
  </div></section>

  <section class="section"><div class="wrap">
    <div class="eyebrow">{uk ? 'План держави' : 'A plan for the state'}</div>
    <h2>{uk ? 'П’ять напрямів, з якими ми йдемо до людей' : 'Five areas we bring to people'}</h2>
    <div class="grid g5" style="margin-top:28px">
      {pillars.map((x) => (
        <a class="card" href={`${href('news', lang)}#${x.id}`}>
          <span class="ico">{x.icon}</span><h3>{x[lang].t}</h3><p class="muted">{x[lang].d}</p>
        </a>
      ))}
    </div>
  </div></section>

  <section class="section soft"><div class="wrap">
    <div class="row-head"><div><div class="eyebrow">{s.team}</div><h2>{uk ? 'Як долучитися до команди' : 'How to join the team'}</h2></div>
      <a class="btn btn-primary" href={href('join', lang)}>{s.join}</a></div>
    <div class="grid g5">
      {statuses.map((x, i) => <div class="card"><span class="num-badge">{i + 1}</span><h3>{x[lang].t}</h3><p class="muted">{x[lang].d}</p></div>)}
    </div>
    <p class="muted" style="margin-top:20px">{uk
      ? 'Ми збираємо людей для парламентських, місцевих і президентських виборів, а також для соціальних, молодіжних, бізнесових, міжнародних та інформаційних проєктів.'
      : 'We are bringing people together for parliamentary, local and presidential elections, and for social, youth, business, international and information projects.'}</p>
  </div></section>

  <section class="section dark"><div class="wrap mission">
    <div>
      <div class="eyebrow">{uk ? 'Місія' : 'Mission'}</div>
      <p class="quote">{uk
        ? 'Відновлювати та зцілювати Україну, якою пишатимуться наші діти, шляхом консолідації нації та впровадження ефективних інститутів.'
        : 'To restore and heal a Ukraine our children will be proud of, by uniting the nation and building effective institutions.'}</p>
    </div>
    <div>
      <div class="eyebrow">{uk ? 'Велика ціль' : 'The big goal'}</div>
      <p class="goal">{uk
        ? 'Відновити геополітичну та економічну самостійність Держави, відновити суверенітет та територіальну цілісність України, забезпечити входження до топ-5 країн Європи протягом 25 років.'
        : 'To restore the state’s geopolitical and economic independence, restore Ukraine’s sovereignty and territorial integrity, and bring Ukraine into Europe’s top five within 25 years.'}</p>
      <a class="btn btn-ghost" href={href('ideas', lang)}>{s.ideas}</a>
    </div>
  </div></section>

  <section class="section"><div class="wrap">
    <div class="row-head"><div><div class="eyebrow">{s.projects}</div><h2>{uk ? 'Проєкти, у яких можна працювати вже зараз' : 'Projects you can join now'}</h2></div>
      <a class="btn btn-outline" href={href('projects', lang)}>{uk ? 'Усі проєкти' : 'All projects'}</a></div>
    <div class="grid g4">
      {featured.map((p) => <div class="card"><h3 style="margin-top:0">{p[lang]}</h3>{p.d && <p class="muted">{p.d[lang]}</p>}</div>)}
    </div>
  </div></section>

  <section class="section soft"><div class="wrap hq">
    <div>
      <div class="eyebrow">{s.team}</div>
      <h2>{uk ? 'Штаби команди' : 'Team HQs'}</h2>
      <p class="muted">{uk ? 'Регіональна мережа штабів розширюється. Хочете відкрити штаб у своїй області? Оберіть статус «Член штабу» в заявці.' : 'The network of regional HQs is growing. Want to open one in your region? Choose “HQ member” in the application.'}</p>
      <ul class="hq-list">
        {hqs.map((h) => <li><strong>{h.name[lang]}</strong><br /><span class="muted">{h.address[lang]}</span><br /><a href={`tel:${h.phone.replace(/\s/g, '')}`}>{h.phone}</a></li>)}
      </ul>
      <a class="btn btn-outline" href={href('team', lang)}>{s.team}</a>
    </div>
    <HqMap lang={lang} />
  </div></section>

  <section class="section"><div class="wrap">
    <div class="row-head"><div><div class="eyebrow">{s.news}</div><h2>{uk ? 'Що відбувається в кампанії' : 'What is happening in the campaign'}</h2></div>
      <a class="btn btn-outline" href={href('news', lang)}>{s.allNews}</a></div>
    {news.length
      ? <div class="grid g3">{news.map((n) => <PostCard lang={lang} href={`${href('news', lang)}${n.id.split('/')[1]}/`} title={n.data.title} date={n.data.date} image={n.data.image} pillar={n.data.pillar} excerpt={n.data.excerpt} />)}</div>
      : <div class="placeholder">{uk ? 'Перші новини кампанії з’являться найближчим часом.' : 'The first campaign news will appear soon.'}</div>}
  </div></section>

  <section class="section soft"><div class="wrap">
    <div class="eyebrow">{s.orgs}</div>
    <h2>{uk ? 'Організації, які працюють разом з нами' : 'Organisations working with us'}</h2>
    <div class="chips" style="margin-top:20px">
      {orgs.map((o) => <a class="chip" href={o.url} target="_blank" rel="noopener">{o[lang]} ↗</a>)}
    </div>
  </div></section>

  <JoinCta lang={lang} />
</Base>

<style>
  .hero { color: #fff; background: radial-gradient(1200px 500px at 85% 0%, rgba(0,197,181,.18), transparent 60%), #23252b; overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.25fr .75fr; align-items: end; gap: 40px; min-height: 560px; padding-top: 56px; }
  .hero-text { padding-bottom: 72px; }
  .hero h1 { font-size: clamp(2.3rem, 5vw, 3.8rem); margin: .25em 0 .35em; }
  .hero-lead { font-size: 1.15rem; color: rgba(255,255,255,.82); max-width: 640px; margin: 0; }
  .hero-sub { font-family: var(--font-head); font-weight: 600; color: var(--accent); margin: .9em 0 0; }
  .portrait { width: 100%; max-height: 520px; object-fit: cover; object-position: top; border-radius: 20px 20px 0 0; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: 1fr; min-height: 0; } .hero-text { padding-bottom: 0; } .portrait { max-height: 360px; } }
  .triad { background: var(--accent); color: #062b28; }
  .tri { padding: 26px 0; display: flex; flex-direction: column; gap: 4px; }
  .tri strong { font-family: var(--font-head); font-size: 1.5rem; text-transform: uppercase; letter-spacing: .04em; }
  .tri span { font-size: .92rem; }
  @media (max-width: 640px) { .tri { padding: 14px 0; } .triad .grid { gap: 0; } }
  .mission { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .quote { font-family: var(--font-head); font-size: clamp(1.3rem, 2.4vw, 1.75rem); line-height: 1.35; margin: .3em 0 0; }
  .goal { font-size: 1.1rem; color: rgba(255,255,255,.82); margin: .4em 0 1.4em; }
  @media (max-width: 860px) { .mission { grid-template-columns: 1fr; gap: 32px; } }
  .hq { display: grid; grid-template-columns: .8fr 1.2fr; gap: 40px; align-items: start; }
  @media (max-width: 860px) { .hq { grid-template-columns: 1fr; } }
  .hq-list { list-style: none; padding: 0; display: grid; gap: 14px; margin: 20px 0 24px; }
  .chips .chip { text-decoration: none; }
</style>
