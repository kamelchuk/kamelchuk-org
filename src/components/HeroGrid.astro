---
import { getCollection } from 'astro:content';
import type { Lang } from '../data/site';
import { photos, socials, topics } from '../data/site';
import { videoOfDay, photoOfDay, myActions } from '../data/today';
import { t, href, fmtDate } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang); const uk = lang === 'uk';
const tg = socials.find((x) => x.name === 'Telegram')!.url;
const ig = socials.find((x) => x.name === 'Instagram')!.url;
const yt = socials.find((x) => x.name === 'YouTube')!.url;
const plain = (md: string) => md.replace(/[#*_>\[\]()`]/g, '').replace(/\s+/g, ' ').trim();
const news = (await getCollection('news', (e) => e.id.startsWith(lang + '/') && !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 4)
  .map((n) => ({ href: `${href('news', lang)}${n.id.split('/')[1]}/`, title: n.data.title, date: n.data.date, pillar: n.data.pillar as string | undefined, text: plain(n.body || '') || n.data.excerpt }));

const pillar = (id?: string) => topics.find((x) => x.id === id)?.[lang].t;
const portrait = '/images/yurii-portrait.jpg';
---
<section class="hg">
  <div class="wrap hg-grid">
    <!-- Ліва колонка -->
    <div class="col left">
      <div class="photo">{portrait ? <img src={portrait} alt={s.name} /> : <span>{uk ? 'Тут буде ваше фото' : 'Your photo here'}</span>}</div>
      <div class="intro">
        <div class="eyebrow">{s.role}</div>
        <h1>{s.name}</h1>
        <p class="lead">{uk
          ? 'Працюю для того, щоб кожне звернення отримало відповідь, а Україна — сильну енергетику, економіку та голос у світі.'
          : 'I work so that every appeal gets an answer, and Ukraine gets strong energy, a strong economy and a voice in the world.'}</p>
        <div class="btns">
          <a class="btn btn-primary" href={href('appeal', lang)}>{s.appeal}</a>
          <a class="btn btn-ghost" href={tg} target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>

    <!-- Середня колонка: новини -->
    <div class="col mid">
      <div class="col-head"><span class="eyebrow">{s.news}</span><a href={href('news', lang)}>{s.allNews} →</a></div>
      <ul class="news">
        {news.map((n) => (
          <li>
            <div class="meta">{pillar(n.pillar) && <span class="tag">{pillar(n.pillar)}</span>}<time>{fmtDate(n.date, lang)}</time></div>
            <a class="nt" href={n.href}>{n.title}</a>
            <p class="nx">{n.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Права колонка -->
    <div class="col right">
      <div class="box">
        <div class="col-head"><span class="eyebrow">{uk ? 'Відео дня' : 'Video of the day'}</span><a href={yt} target="_blank" rel="noopener">YouTube →</a></div>
        <a class="video" href={`https://www.youtube.com/watch?v=${videoOfDay.id}`} target="_blank" rel="noopener">
          <img src={videoOfDay.cover} alt="" loading="lazy" onerror="this.remove()" />
          <span class="play">▶</span>
        </a>
        <p class="cap">{videoOfDay.title[lang]}</p>
      </div>
      <div class="box">
        <div class="col-head"><span class="eyebrow">{uk ? 'Фото дня' : 'Photo of the day'}</span><a href={ig} target="_blank" rel="noopener">Instagram →</a></div>
        <a class="pic" href={photoOfDay.link || ig} target="_blank" rel="noopener">{photoOfDay.image ? <img src={photoOfDay.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span>{photoOfDay.caption[lang]}</span>}</a>
      </div>
      {myActions.items[lang].length > 0 && <div class="box">
        <div class="col-head"><span class="eyebrow">{uk ? 'Мої дії' : 'What I did'}</span><span class="muted-s">{myActions.week[lang]}</span></div>
        <ul class="acts">{myActions.items[lang].map((x) => <li>{x}</li>)}</ul>
      </div>}
    </div>
  </div>
</section>

<style>
  .hg { background: #1b1c21; color: #fff; padding: 32px 0 40px; }
  .hg-grid { display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 28px; max-width: 1320px; }
  .col { min-width: 0; }
  .eyebrow { color: var(--accent); }
  .col-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 12px; }
  .col-head a { font-size: .8rem; color: rgba(255,255,255,.6); text-decoration: none; } .col-head a:hover { color: #fff; }
  .muted-s { font-size: .8rem; color: rgba(255,255,255,.5); }
  /* ліва */
  .left { display: flex; flex-direction: column; gap: 20px; }
  .photo { aspect-ratio: 4/3.6; border-radius: 16px; background: #23252b; display: grid; place-items: center; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; }
  .photo span { color: rgba(255,255,255,.45); font-size: .9rem; }
  .intro .eyebrow { font-size: .7rem; line-height: 1.5; }
  .intro h1 { font-size: clamp(2rem, 3vw, 2.6rem); margin: .25em 0 .35em; }
  .lead { color: rgba(255,255,255,.78); font-size: .98rem; margin: 0; }
  .btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .btns .btn { padding: .7em 1.2em; font-size: .88rem; }
  /* середня */
  .mid { border-left: 1px solid rgba(255,255,255,.08); border-right: 1px solid rgba(255,255,255,.08); padding: 0 28px; }
  .news { list-style: none; margin: 0; padding: 0; }
  .news li { padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.08); }
  .news li:first-child { padding-top: 0; }
  .meta { display: flex; gap: 8px; align-items: center; font-size: .74rem; color: rgba(255,255,255,.5); margin-bottom: 6px; }
  .meta .tag { font-size: .68rem; }
  .nt { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-family: var(--font-head); font-weight: 700; font-size: 1.05rem; line-height: 1.3; color: #fff; text-decoration: none; }
  .nt:hover { color: var(--accent); }
  .nx { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; font-size: .86rem; line-height: 1.5; color: rgba(255,255,255,.68); margin: 6px 0 0; }
  /* права */
  .right { display: flex; flex-direction: column; gap: 22px; }
  .video, .pic { position: relative; display: grid; place-items: center; aspect-ratio: 16/8.5; border-radius: 12px; overflow: hidden; background: linear-gradient(135deg, #2c2f38, #15161a); text-decoration: none; }
  .pic { aspect-ratio: 16/9; }
  .pic img { object-position: center 30%; }
  .pic span { color: rgba(255,255,255,.45); font-size: .85rem; }
  .video img, .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .play { position: relative; width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: #062b28; display: grid; place-items: center; font-size: 1.1rem; padding-left: 3px; }
  .cap { font-size: .86rem; color: rgba(255,255,255,.78); margin: 8px 0 0; }
  .acts { margin: 0; padding-left: 18px; font-size: .88rem; color: rgba(255,255,255,.78); display: grid; gap: 6px; }
  @media (max-width: 1100px) {
    .hg-grid { grid-template-columns: 1fr 1fr; }
    .right { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); }
    .mid { border-right: 0; padding-right: 0; }
  }
  @media (max-width: 760px) {
    .hg-grid { grid-template-columns: 1fr; }
    .right { grid-template-columns: 1fr; }
    .mid { border: 0; padding: 0; }
    .photo { aspect-ratio: 1/1; max-height: 360px; }
  }
</style>
